{
  "compilerOptions": {
    /* ----------------------------------------------------
       Core TypeScript
       ---------------------------------------------------- */
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,

    /* ----------------------------------------------------
       Module & Resolution
       ---------------------------------------------------- */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",

    /* ----------------------------------------------------
       Next.js Environment
       ---------------------------------------------------- */
    "plugins": [
      {
        "name": "next"
      }
    ],

    /* ----------------------------------------------------
       Path Aliases
       ---------------------------------------------------- */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    /* ----------------------------------------------------
       Performance
       ---------------------------------------------------- */
    "incremental": true
  },

  /* ----------------------------------------------------
     Files Included for Type Checking
     ---------------------------------------------------- */
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],

  /* ----------------------------------------------------
     Explicit Exclusions
     ---------------------------------------------------- */
  "exclude": [
    "node_modules",
    "src/lib/ocr"
  ]
}
