"use client";

import React, { useEffect, useState } from "react";

export default function CustomerMenuPage() {
  const vendorId = "674e9c2e30e94e3bb8bdcfc1"; // fixed vendor for now

  const [menu, setMenu] = useState<any>(null);
  const [activeCategory, setActiveCategory] = useState<string>("");
  const [search, setSearch] = useState("");

  const fetchMenu = async () => {
    const res = await fetch(
      `http://localhost:4000/api/vendor/menu?vendorId=${vendorId}`
    );
    const data = await res.json();
    setMenu(data.menu || data);

    if (data.menu?.items?.length) {
      setActiveCategory(data.menu.items[0].category);
    }
  };

  useEffect(() => {
    fetchMenu();
  }, []);

  if (!menu) return <div style={{ padding: 20 }}>Loading menu...</div>;

  // Group items by category
  const grouped = menu.items.reduce((acc: any, item: any) => {
    acc[item.category] = acc[item.category] || [];
    acc[item.category].push(item);
    return acc;
  }, {});

  // Filter by search
  const filterItems = (items: any[]) => {
    if (!search.trim()) return items;
    return items.filter((i) =>
      i.name.toLowerCase().includes(search.toLowerCase())
    );
  };

  return (
    <div style={{ padding: 20, fontFamily: "sans-serif" }}>
      <h1 style={{ marginBottom: 10 }}>📋 Menu</h1>

      {/* Search Bar */}
      <input
        type="text"
        placeholder="Search dishes..."
        value={search}
        onChange={(e) => setSearch(e.target.value)}
        style={{
          width: "100%",
          padding: 10,
          marginBottom: 20,
          borderRadius: 8,
          border: "1px solid #ddd",
        }}
      />

      {/* Category Tabs */}
      <div style={{ display: "flex", overflowX: "auto", marginBottom: 20 }}>
        {Object.keys(grouped).map((cat) => (
          <button
            key={cat}
            onClick={() => setActiveCategory(cat)}
            style={{
              padding: "10px 18px",
              marginRight: 10,
              borderRadius: 30,
              border: "1px solid #ccc",
              background: activeCategory === cat ? "#0070f3" : "#fff",
              color: activeCategory === cat ? "#fff" : "#000",
            }}
          >
            {cat}
          </button>
        ))}
      </div>

      {/* Items Section */}
      {Object.entries(grouped).map(([cat, items]: any) => {
        if (cat !== activeCategory) return null;

        const filtered = filterItems(items);

        return (
          <div key={cat}>
            {filtered.length === 0 ? (
              <p>No items match your search.</p>
            ) : (
              filtered.map((item: any) => (
                <div
                  key={item._id}
                  style={{
                    background: "#fff",
                    borderRadius: 10,
                    padding: 15,
                    marginBottom: 15,
                    boxShadow: "0 2px 8px rgba(0,0,0,0.1)",
                  }}
                >
                  <h3 style={{ margin: "0 0 5px 0" }}>{item.name}</h3>
                  <p style={{ margin: 0, color: "#555" }}>{item.description}</p>
                  <p style={{ marginTop: 8, fontWeight: "bold" }}>₹{item.price}</p>
                </div>
              ))
            )}
          </div>
        );
      })}
    </div>
  );
}
